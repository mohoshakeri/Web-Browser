# Access control — if set, login is required before noVNC / websocket access
ACCESS_PASSWORD=change-me-strong-password

# Secret for signing session cookies (openssl rand -hex 32)
SESSION_SECRET=replace-with-a-long-random-secret

# Authenticated session lifetime in days
SESSION_TTL_DAYS=3

# Set true when serving over HTTPS
COOKIE_SECURE=false

# Cookie SameSite policy: lax | strict | none
COOKIE_SAMESITE=lax

# Virtual display
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080
SCREEN_DEPTH=24

# Chromium profile path inside the container
CHROME_PROFILE=/data/chromium

# Internal auth port (localhost only).
# AUTH_PORT=8090
